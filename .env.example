# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Only the ENZYMEX_DB_* block is required; every other setting has a working
# default. Full reference: docs/configuration.md

# ---------------------------------------------------------------- copied database
# Point this at a COPY of the EnzymeX database. Never at production.
# The account should hold SELECT only:
#   CREATE USER 'enzymex_ro'@'%' IDENTIFIED BY '...';
#   GRANT SELECT ON enzymex_copy.* TO 'enzymex_ro'@'%';
ENZYMEX_DB_HOST=127.0.0.1
ENZYMEX_DB_PORT=3306
ENZYMEX_DB_NAME=enzymex_copy
ENZYMEX_DB_USER=enzymex_ro
ENZYMEX_DB_PASSWORD=
ENZYMEX_DB_TABLE=enzymesdata

# Required acknowledgement. The reference build refuses to connect without it.
ENZYMEX_DB_CONFIRM_COPY=false

# ---------------------------------------------------------------- filesystem
# Generated artifacts and job scratch. Both stay out of git.
ENZYMEX_REFERENCE_DIR=var/reference
ENZYMEX_JOB_DIR=var/jobs

# ---------------------------------------------------------------- executables
# Absolute paths if the tools are not on the service account's PATH.
ENZYMEX_BLASTP_BIN=blastp
ENZYMEX_MAKEBLASTDB_BIN=makeblastdb
ENZYMEX_PHMMER_BIN=phmmer
ENZYMEX_HMMSCAN_BIN=hmmscan
ENZYMEX_HMMBUILD_BIN=hmmbuild
ENZYMEX_HMMPRESS_BIN=hmmpress
ENZYMEX_MAFFT_BIN=mafft
ENZYMEX_MMSEQS_BIN=mmseqs

# ---------------------------------------------------------------- export filters
ENZYMEX_MIN_SEQUENCE_LENGTH=30
ENZYMEX_MAX_REFERENCE_LENGTH=10000
ENZYMEX_MAX_AMBIGUOUS_FRACTION=0.10
# 0 exports the whole table. Set a cap for a first trial build on a large copy.
ENZYMEX_EXPORT_LIMIT=0

# ---------------------------------------------------------------- submission limits
ENZYMEX_MAX_UPLOAD_BYTES=1000000
ENZYMEX_MAX_QUERY_SEQUENCES=10
ENZYMEX_MAX_QUERY_LENGTH=5000

# ---------------------------------------------------------------- search parameters
ENZYMEX_BLAST_EVALUE=0.001
ENZYMEX_PHMMER_EVALUE=0.001
ENZYMEX_HMMSCAN_EVALUE=0.001
ENZYMEX_MAX_HITS_PER_QUERY=25
ENZYMEX_SEARCH_THREADS=2
ENZYMEX_BLAST_TIMEOUT_SECONDS=120
ENZYMEX_HMMER_TIMEOUT_SECONDS=300
ENZYMEX_MAX_CONCURRENT_JOBS=2

ENZYMEX_ENABLE_BLAST=true
ENZYMEX_ENABLE_PHMMER=true
ENZYMEX_ENABLE_PROFILE_HMM=true

# ---------------------------------------------------------------- reference build
ENZYMEX_BUILD_THREADS=4
ENZYMEX_CLUSTER_MIN_SEQ_ID=0.35
ENZYMEX_CLUSTER_COVERAGE=0.80
ENZYMEX_PROFILE_MIN_MEMBERS=5
ENZYMEX_PROFILE_MAX_MEMBERS=500
ENZYMEX_PROFILE_MIN_MATCH_STATES=40
ENZYMEX_BUILD_TIMEOUT_SECONDS=7200

# ---------------------------------------------------------------- web
ENZYMEX_JOB_RETENTION_HOURS=24
ENZYMEX_KEEP_RAW_OUTPUTS=true
ENZYMEX_LOG_LEVEL=INFO
