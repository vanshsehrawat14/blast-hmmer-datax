# The repository is developed on Windows and deployed on Linux, so everything
# that a Linux process reads is pinned to LF regardless of core.autocrlf.
# A CRLF checkout breaks shebang lines, Docker builds and systemd units.
*.sh   text eol=lf
*.py   text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.service text eol=lf
.env.example text eol=lf
.dockerignore text eol=lf

# Templates and static assets are served verbatim; keep them LF so byte
# offsets and checksums match between a Windows checkout and the server.
*.html text eol=lf
*.css  text eol=lf
*.toml text eol=lf

# Bioinformatics formats are parsed by Unix tools; keep them LF.
*.fasta text eol=lf
*.afa   text eol=lf
*.tsv   text eol=lf
*.hmm   text eol=lf

*.md   text
*.yml  text
*.json text

# Screenshots in docs/. Never touch these.
*.jpg binary
*.png binary
*.pptx binary
