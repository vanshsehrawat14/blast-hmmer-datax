# Secrets. Never commit.
.env
!.env.example

# Generated reference artifacts, job scratch, and the local MySQL fixture
# cache. All of it is rebuilt by `make refbuild`; none of it belongs in git.
var/

# ---------------------------------------------------------------------------
# Proof-of-concept pipeline (scripts/0*.sh, Makefile poc-* targets)
# ---------------------------------------------------------------------------

# BLAST database indexes (regenerate with `make poc-blast`)
data/processed/blastdb/

# DIAMOND database index (regenerate with `make poc-diamond`)
data/processed/diamonddb/

# Generated alignment and profile (regenerate with `make poc-hmmer`)
data/processed/reference_aligned.afa
data/processed/ec_1_1_1_1.hmm

# Regenerable tool dumps: logs, full-text and pairwise output. Rebuilt by
# `make`. The tabular (*_tblout/*_domtblout/*_hits.tsv) and normalized results
# are kept as committed evidence.
results/*/*.log
results/hmmer/*_full.txt
results/blast/blastp_pairwise.txt
results/diamond/diamond_pairwise.txt

# Environments
.conda/
envs/
venv/
.venv/
micromamba/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

