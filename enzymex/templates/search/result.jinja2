{% extends "ecpick:templates/layout.jinja2" %}
{% block pageTitle %}Sequence search results{% endblock %}
{% block pageContent %}
<div class="col-12">

  <div class="page-header mb-3">
    <h2 class="page-title">Sequence-comparison evidence</h2>
    <div class="text-muted mt-1">
      Job <code>{{ result.job_id }}</code> &middot;
      build <code>{{ result.reference_build_id }}</code> &middot;
      {{ result.queries|length }} sequence{{ '' if result.queries|length == 1 else 's' }} &middot;
      {{ result.total_runtime_seconds }}s
    </div>
  </div>

  <div class="alert alert-info" role="alert">
    <strong>How to read this.</strong> These tables say a submitted sequence
    resembles something in the reference set. Homologues often share function,
    but not always, and similarity alone does not establish a shared EC number.
    No EC prediction model runs here &mdash; these results sit alongside ECPICK,
    HIT-EC and CLEAN, they do not replace them.
  </div>

  {% for note in result.notes %}
  <div class="alert alert-warning" role="alert">{{ note }}</div>
  {% endfor %}

  {% set p = result.search_parameters %}
  {% if p %}
  <details class="card mb-3">
    <summary class="card-header" style="cursor: pointer; font-weight: 600;">
      Parameters used
    </summary>
    <div class="card-body">
      {% include "ecpick:templates/search/_parameters.jinja2" %}
    </div>
  </details>
  {% endif %}

  {% for q in result.queries %}
  <div class="card mb-3">
    <div class="card-header">
      <h3 class="card-title mb-0">
        <code>{{ q.query_id }}</code>
        {{ q.query_description }}
        <span class="text-muted">{{ q.query_length }} aa</span>
      </h3>
    </div>

    {% for m in q.methods %}
    <div class="card-body">
      {% include "ecpick:templates/search/_method.jinja2" %}
    </div>
    {% endfor %}
  </div>
  {% endfor %}

  <a class="btn" href="{{ request.route_url('search') }}">New search</a>

</div>
{% endblock %}
