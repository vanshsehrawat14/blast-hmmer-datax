{#
  One method's hits, for one query.

  Included twice: by the standalone result page, and by the fragment the
  buttons on ECPICK's EC result page fetch. Both render the same markup from
  here so the two pages cannot drift apart as the columns change.

  Expects: m (MethodResult), method_labels, thresholds, fmt.
#}
<h4>
  {{ method_labels[m.method] }}
  {% if m.method_version %}<span class="text-muted small">{{ m.method_version }}</span>{% endif %}
  {% if m.runtime_seconds is not none %}<span class="text-muted small">{{ m.runtime_seconds }}s</span>{% endif %}
</h4>

{% if m.status.value == 'failed' %}
  <div class="alert alert-danger mb-0" role="alert">
    <strong>{{ m.error_code.value.replace('_', ' ') if m.error_code else 'failed' }}.</strong>
    {{ m.error_message }}
    The other methods on this page ran independently and are unaffected.
  </div>

{% elif m.status.value == 'disabled' %}
  <p class="text-muted mb-0">Not run: {{ m.error_message }}</p>

{% elif m.status.value == 'no_hits' %}
  <p class="text-muted mb-0">
    <strong>No hits.</strong> Nothing in the
    {% if m.method == 'hmmscan' %}profile database{% else %}reference set{% endif %}
    scored better than that method's reporting threshold
    (E &le; {{ '%.0e'|format(thresholds[m.method]) }}).
    For a real protein this usually means the reference set holds no close
    relative. It is not evidence that the protein is not an enzyme.
  </p>

{% elif m.method == 'blastp' %}
  <div class="table-responsive">
    <table class="table table-hover table-vcenter table-sm mb-0">
      <thead>
        <tr>
          <th>#</th><th>Reference</th><th>Description</th><th>EC</th>
          <th>Source</th><th class="text-end">Identity</th>
          <th class="text-end">Aln len</th><th class="text-end">Query cov</th>
          <th class="text-end">Subject cov</th><th class="text-end">E-value</th>
          <th class="text-end">Bit score</th>
        </tr>
      </thead>
      <tbody>
      {% for h in m.hits %}
        <tr>
          <td>{{ h.rank }}</td>
          <td><code>{{ h.hit_id }}</code></td>
          <td>{{ h.hit_description or '—' }}</td>
          <td><code>{{ h.hit_ec or '—' }}</code></td>
          <td>{{ h.hit_source or '—' }}</td>
          <td class="text-end">{{ fmt.percent1(h.percent_identity) }}</td>
          <td class="text-end">{{ h.alignment_length if h.alignment_length is not none else '—' }}</td>
          <td class="text-end{% if h.query_coverage is not none and h.query_coverage < 0.5 %} text-danger{% endif %}">{{ fmt.fraction(h.query_coverage) }}</td>
          <td class="text-end">{{ fmt.fraction(h.subject_coverage) }}</td>
          <td class="text-end"><code>{{ fmt.evalue(h.evalue) }}</code></td>
          <td class="text-end">{{ fmt.number(h.bitscore) }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <small class="form-text text-muted">
    Identity and alignment length describe the single best-scoring local
    alignment; coverage is summed over every high-scoring pair for that
    reference. High identity over a short stretch is weak evidence, so
    read the coverage column alongside it.
  </small>

{% elif m.method == 'phmmer' %}
  <div class="table-responsive">
    <table class="table table-hover table-vcenter table-sm mb-0">
      <thead>
        <tr>
          <th>#</th><th>Reference</th><th>Description</th><th>EC</th>
          <th>Source</th><th class="text-end">Query cov</th>
          <th class="text-end">Subject cov</th><th class="text-end">Seq E-value</th>
          <th class="text-end">Seq bits</th><th class="text-end">Best dom E</th>
          <th class="text-end">Dom bits</th><th class="text-end">Query region</th>
        </tr>
      </thead>
      <tbody>
      {% for h in m.hits %}
        <tr>
          <td>{{ h.rank }}</td>
          <td><code>{{ h.hit_id }}</code></td>
          <td>{{ h.hit_description or '—' }}</td>
          <td><code>{{ h.hit_ec or '—' }}</code></td>
          <td>{{ h.hit_source or '—' }}</td>
          <td class="text-end{% if h.query_coverage is not none and h.query_coverage < 0.5 %} text-danger{% endif %}">{{ fmt.fraction(h.query_coverage) }}</td>
          <td class="text-end">{{ fmt.fraction(h.subject_coverage) }}</td>
          <td class="text-end"><code>{{ fmt.evalue(h.evalue) }}</code></td>
          <td class="text-end">{{ fmt.number(h.bitscore) }}</td>
          <td class="text-end"><code>{{ fmt.evalue(h.domain_evalue) }}</code></td>
          <td class="text-end">{{ fmt.number(h.domain_bitscore) }}</td>
          <td class="text-end"><code>{{ h.domain_start }}–{{ h.domain_end }}</code>{% if h.domain_count and h.domain_count > 1 %} <span class="text-muted">(+{{ h.domain_count - 1 }})</span>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <small class="form-text text-muted">
    phmmer reports no percent identity, so that column does not exist
    here. Its E-values come from HMMER's own model over this reference
    database and are <strong>not</strong> comparable with the BLAST
    E-values above, even for the same hit.
  </small>

{% else %}
  <div class="table-responsive">
    <table class="table table-hover table-vcenter table-sm mb-0">
      <thead>
        <tr>
          <th>#</th><th>Profile</th><th>Family</th><th>Consensus EC</th>
          <th class="text-end">EC purity</th><th class="text-end">Members</th>
          <th class="text-end">Query cov</th><th class="text-end">Profile cov</th>
          <th class="text-end">Seq E-value</th><th class="text-end">Seq bits</th>
          <th class="text-end">Dom bits</th><th class="text-end">Query region</th>
        </tr>
      </thead>
      <tbody>
      {% for h in m.hits %}
        <tr>
          <td>{{ h.rank }}</td>
          <td><code>{{ h.hit_id }}</code></td>
          <td>{{ h.hit_description or '—' }}</td>
          <td><code>{{ h.hit_ec or 'unannotated' }}</code></td>
          <td class="text-end">{{ fmt.fraction(h.family_ec_purity) }}</td>
          <td class="text-end">{{ h.family_size if h.family_size is not none else '—' }}</td>
          <td class="text-end{% if h.query_coverage is not none and h.query_coverage < 0.5 %} text-danger{% endif %}">{{ fmt.fraction(h.query_coverage) }}</td>
          <td class="text-end">{{ fmt.fraction(h.subject_coverage) }}</td>
          <td class="text-end"><code>{{ fmt.evalue(h.evalue) }}</code></td>
          <td class="text-end">{{ fmt.number(h.bitscore) }}</td>
          <td class="text-end">{{ fmt.number(h.domain_bitscore) }}</td>
          <td class="text-end"><code>{{ h.domain_start }}–{{ h.domain_end }}</code>{% if h.domain_count and h.domain_count > 1 %} <span class="text-muted">(+{{ h.domain_count - 1 }})</span>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <small class="form-text text-muted">
    Each profile models one cluster of homologous references, not one EC
    number. <em>EC purity</em> is the share of annotated members carrying
    the consensus EC. A low value means the family spans several
    reactions, so the EC shown is not a prediction. These E-values are
    scored against the profile database, a third scale again, comparable
    neither to BLAST nor to phmmer.
  </small>
{% endif %}
